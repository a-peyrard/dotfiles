if [ -n "$SSH_CONNECTION" ]; then
  _host=$(hostname -s)
  _color=$(echo "$_host" | md5sum | tr -d 'a-f -' | cut -c1-3)
  _color=$(( (_color % 230) + 1 ))
  _conf="$HOME/.config/starship_generated.toml"

  if [ ! -f "$_conf" ] || ! grep -q "color:${_color}" "$_conf" 2>/dev/null; then
    cp "$HOME/.config/starship.toml" "$_conf"
    cat >> "$_conf" << EOF

[custom.host]
when = '[ -n "\$SSH_CONNECTION" ]'
command = 'hostname -s'
format = "[\\\\[@\$output\\\\]](color:${_color}): "
EOF
  fi

  export STARSHIP_CONFIG="$_conf"
fi
