#!/bin/bash
# nvc — Neovim Claude companion
#
# Usage:
#   nvc <file>:<line>                           Open file at line
#   nvc --highlight-function <file>:<line>      Highlight function block
#   nvc --highlight <file>:<line>               Highlight any block (for, if, import...)
#   nvc --highlight-lines <file>:<s>-<e>[,...]  Highlight line ranges
#   nvc --diff <file>                           Show proposed changes (stdin) as diff
#   nvc --clear                                 Clear all highlights
#   nvc --close-diff                            Close diff view
#   nvc [--full-screen] review [--light] [--amend|--since-publish] [D12345|hash|.]
#                                        --light: gutter highlights instead of diffview
#                                        --amend: show only changes from last amend (vs predecessor)
#                                        --since-publish: show changes since last jf submit (vs published version)
#   nvc sessions                                  List all nvim sessions across tmux windows
#   nvc clean                                     Remove stale session/socket files
#   nvc restart                                   Restart nvim preserving buffers/state
#   nvc kill                                     Force-kill hung nvim + clean socket
#   nvc cmd '<Esc>:SomeCommand<CR>'             Send raw keys to nvim
#   nvc expr '<vimscript-expr>'                 Evaluate expression, return result
#   nvc errors                                  Get recent errors (noice-aware)
#   nvc messages                                Get raw :messages output
#   nvc send [--no-submit] [--file <path>]       Send prompt to Claude Code pane
#   nvc diff-review <file>                      Interactive diff review (stdin = proposed)
#   nvc diagnostics [file]                      Get LSP diagnostics from nvim
#   nvc buffers                                 List open buffers with metadata
#   nvc debug set-breakpoints <file:line> ...   Set DAP breakpoints at locations
#   nvc debug attach                            Start DAP from /tmp/fdb-dap.json
#   nvc debug clear-breakpoints                 Clear all breakpoints
#
# Multiple highlight flags can be chained:
#   nvc --highlight-function f.py:43 --highlight-lines f.py:99-114,160-171
#
# All commands auto-spawn nvim in a tmux pane if none is running.
#
#   --full-screen    Run nvim in the current pane (no split). For use in
#                    dedicated tmux windows (devbridge handlers, standalone review).

set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: nvc <file>:<line>                         Open file at line"
    echo "       nvc --highlight-function <file>:<line>    Highlight function block"
    echo "       nvc --highlight <file>:<line>             Highlight any block"
    echo "       nvc --highlight-lines <file>:<s>-<e>      Highlight line ranges"
    echo "       nvc --diff <file>                         Show proposed changes (stdin)"
    echo "       nvc --clear                               Clear all highlights"
    echo "       nvc --close-diff                          Close diff view"
    echo "       nvc review [--light] [--amend|--since-publish] [D12345|hash|.]"
    echo "                                                 Review diff/commit/rev"
    echo "       nvc send [--no-submit] [--file <path>]    Send prompt to Claude pane"
    echo "       nvc diff-review <file>                    Interactive diff review (stdin)"
    echo "       nvc diagnostics [file]                    Get LSP diagnostics"
    echo "       nvc buffers                               List open buffers"
    echo "       nvc notes [clear|remove <file:line>]      Read/manage review notes"
    echo "       nvc sessions                              List all nvim sessions"
    echo "       nvc clean                                 Remove stale session files"
    echo "       nvc restart                               Restart nvim (preserve state)"
    echo "       nvc quit                                  Close nvim + clean session"
    echo "       nvc kill                                  Force-kill hung nvim"
    echo "       nvc debug set-breakpoints <file:line> ... Set DAP breakpoints"
    echo "       nvc debug attach                          Start DAP session"
    echo "       nvc debug clear-breakpoints               Clear all breakpoints"
    echo "       nvc cmd '<keys>'                          Send raw keys to nvim"
    echo "       nvc expr '<expr>'                         Eval vimscript expression"
    echo "       nvc errors                                Get errors (noice-aware)"
    echo "       nvc messages                              Get raw :messages"
    echo "       nvc test [name|--list]                    Run integration tests"
    echo ""
    echo "Multiple highlight flags can be chained. All commands auto-spawn nvim."
    echo "Options: --full-screen  Run nvim in current pane (no split)"
    exit 0
fi

FULL_SCREEN=false
if [[ "${1:-}" == "--full-screen" ]]; then
    FULL_SCREEN=true
    shift
fi

# ============================================================================
# Debug logging — set NVC_DEBUG=1 to enable
# ============================================================================

NVC_LOG="/tmp/nvc-debug.log"

nvc_log() {
    if [ "${NVC_DEBUG:-0}" = "1" ]; then
        echo "[$(date '+%H:%M:%S')] [$$] $*" >> "$NVC_LOG"
    fi
}

nvc_log "--- nvc ${1:-} (TMUX_PANE=${TMUX_PANE:-none}, NVC_SESSION_ID=${NVC_SESSION_ID:-none})"

# ============================================================================
# UUID-based session pairing
#
# Each Claude-nvim pair shares a UUID. Three files per pair:
#   /tmp/nvim-claude-$USER-$UUID.sock  — nvim socket (Claude → nvim)
#   /tmp/nvc-claude-$UUID              — Claude's pane ID (nvim → Claude)
#   /tmp/nvc-me-$PANE                  — UUID lookup (pane → UUID)
#
# Resolution:
#   Claude → nvim: $TMUX_PANE → nvc-me file → UUID → socket
#   nvim → Claude: $NVC_SESSION_ID → nvc-claude file → pane ID → paste-buffer
# ============================================================================

generate_session_id() {
    head -c4 /dev/urandom | xxd -p
}

# Resolve session UUID from env var or lookup file
SESSION_ID="${NVC_SESSION_ID:-}"
if [ -z "$SESSION_ID" ] && [ -f "/tmp/nvc-me-${TMUX_PANE:-}" ]; then
    SESSION_ID=$(cat "/tmp/nvc-me-${TMUX_PANE}")
    nvc_log "resolved UUID from nvc-me file: ${SESSION_ID}"
fi

# Derive socket from session ID (empty if no session yet)
if [ -n "$SESSION_ID" ]; then
    SOCK="/tmp/nvim-claude-${USER}-${SESSION_ID}.sock"
    nvc_log "socket: ${SOCK} (exists=$([ -S "$SOCK" ] && echo yes || echo no))"
else
    SOCK=""
    nvc_log "no session — SOCK empty"
fi

# ============================================================================
# Low-level helpers
# ============================================================================

spawn_nvim() {
    local cmd="NVC_SESSION_ID=${SESSION_ID} $1"
    if $FULL_SCREEN; then
        exec bash -c "$cmd"
    else
        tmux split-window -t "${TMUX_PANE}" -h -l 50% "$cmd"
    fi
}

socket_alive() {
    [ -n "$SOCK" ] && [ -S "$SOCK" ] && nvim --server "$SOCK" --remote-expr "1" >/dev/null 2>&1
}

wait_for_socket() {
    local attempts=0
    while [ $attempts -lt 30 ]; do
        if socket_alive; then return 0; fi
        sleep 0.3
        attempts=$((attempts + 1))
    done
    return 1
}

# Resolve Claude's pane ID from session
resolve_claude_pane() {
    if [ -n "$SESSION_ID" ] && [ -f "/tmp/nvc-claude-${SESSION_ID}" ]; then
        local pane
        pane=$(cat "/tmp/nvc-claude-${SESSION_ID}")
        nvc_log "resolve_claude: file says pane=${pane}"
        if tmux display-message -t "$pane" -p '#{pane_id}' >/dev/null 2>&1; then
            nvc_log "resolve_claude: pane ${pane} alive"
            echo "$pane"
            return 0
        fi
        nvc_log "resolve_claude: pane ${pane} dead — cleaning"
        rm -f "/tmp/nvc-claude-${SESSION_ID}"
    fi
    nvc_log "resolve_claude: no valid Claude pane"
    return 1
}

# Bootstrap a new Claude session and pair it with current UUID
bootstrap_claude() {
    # Ensure we have a session ID
    if [ -z "$SESSION_ID" ]; then
        SESSION_ID=$(generate_session_id)
        SOCK="/tmp/nvim-claude-${USER}-${SESSION_ID}.sock"
        echo "$SESSION_ID" > "/tmp/nvc-me-${TMUX_PANE}"
        nvc_log "bootstrap: generated new session ${SESSION_ID}"
    fi

    # Capture the exact new pane ID — no ambiguity with existing Claude panes
    local claude_pane
    claude_pane=$(tmux split-window -t "${TMUX_PANE}" -h -l 50% -P -F '#{pane_id}' 'claude')
    nvc_log "bootstrap: spawned Claude in pane ${claude_pane}"

    # Wait for Claude to be ready
    local attempts=0
    while [ $attempts -lt 20 ]; do
        local cmd
        cmd=$(tmux display-message -t "$claude_pane" -p '#{pane_current_command}' 2>/dev/null || true)
        if [[ "$cmd" == *claude* || "$cmd" == *node* ]]; then
            echo "$SESSION_ID" > "/tmp/nvc-me-${claude_pane}"
            echo "$claude_pane" > "/tmp/nvc-claude-${SESSION_ID}"
            nvc_log "bootstrap: paired ${claude_pane} with session ${SESSION_ID}"
            echo "$claude_pane"
            return 0
        fi
        sleep 0.5
        attempts=$((attempts + 1))
    done

    echo "Error: timed out waiting for Claude Code to start" >&2
    return 1
}

ensure_nvim_running() {
    # Already connected? Done.
    if socket_alive; then return 0; fi

    # Stale socket — clean up
    [ -n "$SOCK" ] && [ -e "$SOCK" ] && rm -f "$SOCK"

    # Generate session if none exists
    if [ -z "$SESSION_ID" ]; then
        SESSION_ID=$(generate_session_id)
        SOCK="/tmp/nvim-claude-${USER}-${SESSION_ID}.sock"
    fi

    # Write pairing files
    echo "$SESSION_ID" > "/tmp/nvc-me-${TMUX_PANE}"
    echo "${TMUX_PANE}" > "/tmp/nvc-claude-${SESSION_ID}"

    # Spawn fresh nvim
    spawn_nvim "nvim --listen $SOCK"
    echo "Spawned nvim in new pane" >&2
    if ! wait_for_socket; then
        echo "Error: timed out waiting for nvim socket" >&2
        exit 1
    fi
}

# ============================================================================
# Subcommands: cmd, expr, errors, messages, review, debug
# ============================================================================

case "${1:-}" in
    sessions)
        # List all nvim sessions across tmux windows
        printf "  %-28s %-8s %-8s %-10s %-10s %-28s %s\n" "Window" "Nvim" "Claude" "Socket" "Status" "Session" "Buffer"
        printf "  %-28s %-8s %-8s %-10s %-10s %-28s %s\n" "------" "----" "------" "------" "------" "-------" "------"

        # Collect unique session IDs from nvc-me files
        declare -A seen_sessions
        for f in /tmp/nvc-me-*; do
            [ -f "$f" ] || continue
            sid=$(cat "$f" 2>/dev/null)
            [ -z "$sid" ] && continue
            [ -n "${seen_sessions[$sid]:-}" ] && continue
            seen_sessions[$sid]=1

            sock="/tmp/nvim-claude-${USER}-${sid}.sock"
            claude_pane=$(cat "/tmp/nvc-claude-${sid}" 2>/dev/null || echo "")

            # Find the nvim pane (search nvc-me files for this session)
            nvim_pane=""
            for mf in /tmp/nvc-me-*; do
                mp=$(basename "$mf" | sed 's/nvc-me-//')
                ms=$(cat "$mf" 2>/dev/null)
                if [ "$ms" = "$sid" ]; then
                    cmd=$(tmux display-message -t "$mp" -p '#{pane_current_command}' 2>/dev/null || true)
                    if [ "$cmd" = "nvim" ]; then
                        nvim_pane="$mp"
                        break
                    fi
                fi
            done
            [ -z "$nvim_pane" ] && continue

            # Get window info from nvim pane
            win_info=$(tmux display-message -t "$nvim_pane" -p '#{window_index} (#{window_name})' 2>/dev/null || echo "?")

            # Check socket status and get buffer
            status="dead"
            buffer=""
            if [ -S "$sock" ] && timeout 2 nvim --server "$sock" --remote-expr "1" >/dev/null 2>&1; then
                status="alive"
                buffer=$(timeout 2 nvim --server "$sock" --remote-expr 'fnamemodify(bufname(), ":t")' 2>/dev/null || echo "?")
            fi

            # Get Claude session name from window name
            claude_name="—"
            if [ -n "$claude_pane" ]; then
                claude_name=$(tmux display-message -t "$claude_pane" -p '#{window_name}' 2>/dev/null || echo "—")
            fi

            printf "  %-28s %-8s %-8s %-10s %-10s %-28s %s\n" \
                "$win_info" "$nvim_pane" "${claude_pane:-—}" "${sid:0:8}" "$status" "$claude_name" "$buffer"
        done
        exit 0
        ;;
    clean)
        # Remove stale session files for dead nvim/panes
        cleaned=0
        for f in /tmp/nvc-me-*; do
            [ -f "$f" ] || continue
            pane=$(basename "$f" | sed 's/nvc-me-//')
            # Check if pane still exists in tmux
            if ! tmux display-message -t "$pane" -p '' >/dev/null 2>&1; then
                rm -f "$f"
                cleaned=$((cleaned + 1))
            fi
        done
        for f in /tmp/nvc-claude-*; do
            [ -f "$f" ] || continue
            sid=$(basename "$f" | sed 's/nvc-claude-//')
            sock="/tmp/nvim-claude-${USER}-${sid}.sock"
            # If socket is gone or dead, clean up
            if [ ! -S "$sock" ] || ! timeout 2 nvim --server "$sock" --remote-expr "1" >/dev/null 2>&1; then
                rm -f "$f" "$sock" 2>/dev/null
                cleaned=$((cleaned + 1))
            fi
        done
        # Clean stale session vim/lua files
        for f in /tmp/nvim-claude-session-*.vim /tmp/nvim-claude-highlight.lua /tmp/nvim-claude-light-review.lua; do
            [ -f "$f" ] && rm -f "$f" && cleaned=$((cleaned + 1))
        done
        echo "Cleaned $cleaned stale files"
        exit 0
        ;;
    debug)
        # Debug subcommands: set-breakpoints, attach, clear-breakpoints
        shift
        subcmd="${1:-}"
        shift || true

        case "$subcmd" in
            set-breakpoints)
                # Set breakpoints at file:line locations (additive, preserves existing)
                # Usage: nvc debug set-breakpoints /path/file.py:42 /path/file.py:87
                if [ $# -eq 0 ]; then
                    echo "Usage: nvc debug set-breakpoints <file:line> [<file:line> ...]" >&2
                    exit 1
                fi

                ensure_nvim_running

                # Build Lua snippet to set breakpoints
                LUA_LINES="local bps = require('dap.breakpoints')"
                FIRST_FILE=""
                FIRST_LINE=""
                BP_IDX=0
                for arg in "$@"; do
                    FILE="${arg%:*}"
                    LINE="${arg##*:}"
                    # Resolve to absolute path
                    [[ "$FILE" != /* ]] && FILE="$(pwd)/$FILE"
                    if [ ! -f "$FILE" ]; then
                        echo "Warning: file not found: $FILE" >&2
                        continue
                    fi
                    LUA_LINES="${LUA_LINES}
local b${BP_IDX} = vim.fn.bufnr('${FILE}', true)
vim.fn.bufload(b${BP_IDX})
bps.set({}, b${BP_IDX}, ${LINE})"
                    BP_IDX=$((BP_IDX + 1))
                    if [ -z "$FIRST_FILE" ]; then
                        FIRST_FILE="$FILE"
                        FIRST_LINE="$LINE"
                    fi
                done

                # Navigate to first breakpoint
                if [ -n "$FIRST_FILE" ]; then
                    LUA_LINES="${LUA_LINES}
vim.cmd('edit ${FIRST_FILE}')
vim.api.nvim_win_set_cursor(0, {${FIRST_LINE}, 0})
vim.cmd('normal! zz')"
                fi

                LUA_LINES="${LUA_LINES}
vim.notify('Set $# tour breakpoint(s)', vim.log.levels.INFO)"

                echo "$LUA_LINES" > /tmp/nvim-claude-debug.lua
                nvim --server "$SOCK" --remote-send "<Esc>:luafile /tmp/nvim-claude-debug.lua<CR>"
                echo "Set $# breakpoint(s)" >&2
                ;;

            attach)
                # Trigger DAP attach from /tmp/fdb-dap.json
                ensure_nvim_running
                nvim --server "$SOCK" --remote-send "<Esc>:lua vim.schedule(function() if _G.FdbDap and _G.FdbDap.debug_from_file then _G.FdbDap.debug_from_file() else vim.notify('FdbDap not loaded', vim.log.levels.ERROR) end end)<CR>"
                echo "DAP attach triggered" >&2
                ;;

            clear-breakpoints)
                # Clear all breakpoints
                ensure_nvim_running
                nvim --server "$SOCK" --remote-send "<Esc>:lua require('dap.breakpoints').clear(); vim.notify('All breakpoints cleared')<CR>"
                echo "Cleared all breakpoints" >&2
                ;;

            *)
                echo "Usage: nvc debug <set-breakpoints|attach|clear-breakpoints>" >&2
                echo "  set-breakpoints <file:line> ...  Set breakpoints at locations" >&2
                echo "  attach                           Start DAP from /tmp/fdb-dap.json" >&2
                echo "  clear-breakpoints                Clear all breakpoints" >&2
                exit 1
                ;;
        esac
        exit 0
        ;;
    quit|close)
        # Close the nvim instance and clean up session
        if socket_alive; then
            nvim --server "$SOCK" --remote-send '<C-\><C-n>:lua pcall(function() require("dap").terminate() end); vim.cmd("qa!")<CR>'
            # Clean up session files
            if [ -n "$SESSION_ID" ]; then
                sleep 0.3
                rm -f "$SOCK" "/tmp/nvc-claude-${SESSION_ID}" "/tmp/nvc-me-${TMUX_PANE}"
            fi
            echo "Nvim closed"
        else
            echo "No nvim instance running"
        fi
        exit 0
        ;;
    restart)
        # Restart nvim preserving open buffers and cursor positions.
        # Saves session → quits → respawns with same socket + UUID.
        VIM_SESSION="/tmp/nvim-claude-session-${SESSION_ID:-default}.vim"
        if ! socket_alive; then
            echo "No nvim running — use nvc to open one" >&2
            exit 1
        fi

        NVIM_CWD=$(nvim --server "$SOCK" --remote-expr 'getcwd()' 2>/dev/null || pwd)

        # Save session and quit
        nvim --server "$SOCK" --remote-send "<Esc>:mksession! ${VIM_SESSION}<CR>"
        sleep 0.3
        nvim --server "$SOCK" --remote-send '<C-\><C-n>:lua pcall(function() require("dap").terminate() end); vim.cmd("qa!")<CR>'
        sleep 1
        [ -e "$SOCK" ] && rm -f "$SOCK"

        # Respawn with same socket and UUID
        spawn_nvim "bash -c 'cd ${NVIM_CWD} && nvim --listen ${SOCK} -c \"source ${VIM_SESSION}\"'"
        if wait_for_socket; then
            echo "Nvim restarted (session restored)" >&2
        else
            echo "Error: timed out waiting for nvim" >&2
            exit 1
        fi
        exit 0
        ;;
    kill)
        # Force-kill — kill nvim process, clean up session files and socket.
        # ONLY use when explicitly requested by the user. Never call automatically.
        if [ -n "$SOCK" ]; then
            NVIM_PID=$(pgrep -f "nvim.*--listen.*${SOCK}" 2>/dev/null || true)
            if [ -n "$NVIM_PID" ]; then
                kill "$NVIM_PID" 2>/dev/null || true
                echo "Killed nvim (PID $NVIM_PID)" >&2
            fi
            rm -f "$SOCK"
            echo "Removed socket" >&2
        fi
        if [ -n "$SESSION_ID" ]; then
            rm -f "/tmp/nvc-claude-${SESSION_ID}" "/tmp/nvc-me-${TMUX_PANE}"
            echo "Cleaned session ${SESSION_ID}" >&2
        fi
        if [ -z "$SESSION_ID" ] && [ -z "$SOCK" ]; then
            echo "No session to clean" >&2
        fi
        exit 0
        ;;
    notes)
        # Read, clear, or remove notes
        # Usage: nvc notes              — read all notes (auto-detect scope)
        #        nvc notes [D12345]     — read notes for a specific diff
        #        nvc notes clear        — clear all notes
        #        nvc notes remove <file>:<line> — remove a specific note
        shift
        SUBCMD="${1:-}"

        # Handle subcommands first
        if [ "$SUBCMD" = "clear" ]; then
            if socket_alive; then
                nvim --server "$SOCK" --remote-send '<Esc>:lua _G.Notes.clear()<CR>'
                echo "Notes cleared" >&2
            else
                echo "No nvim instance running" >&2
            fi
            exit 0
        fi

        if [ "$SUBCMD" = "remove" ]; then
            shift
            LOCATION="${1:-}"
            if [ -z "$LOCATION" ]; then
                echo "Usage: nvc notes remove <file>:<line>" >&2
                exit 1
            fi
            FILE="${LOCATION%:*}"
            LINE="${LOCATION##*:}"
            # Resolve to absolute path
            [[ "$FILE" != /* ]] && FILE="$(pwd)/$FILE"
            if socket_alive; then
                nvim --server "$SOCK" --remote-send "<Esc>:lua _G.Notes.remove('${FILE}', ${LINE})<CR>"
                echo "Removed note at ${LOCATION}" >&2
            else
                echo "No nvim instance running" >&2
            fi
            exit 0
        fi

        DIFF_ID="$SUBCMD"
        if [ -z "$DIFF_ID" ]; then
            # Try to get from nvim's review context
            if socket_alive; then
                DIFF_ID=$(nvim --server "$SOCK" --remote-expr 'get(g:, "review_diff_id", "")' 2>/dev/null || true)
            fi
            # Fall back to current commit in the current repo
            if [ -z "$DIFF_ID" ]; then
                DIFF_ID=$(sl log --rev . --template '{phabdiff}' 2>/dev/null || git log -1 --format='%H' 2>/dev/null || echo "")
            fi
        fi

        # Try review notes first (diff-based)
        if [ -n "$DIFF_ID" ]; then
            NOTES_FILE="/tmp/nvc-review-${DIFF_ID}.md"
            if [ -f "$NOTES_FILE" ] && [ -s "$NOTES_FILE" ]; then
                cat "$NOTES_FILE"
                exit 0
            fi
        fi

        # Fall back to cwd-based code notes (use nvim's cwd, not shell's)
        if socket_alive; then
            NVIM_CWD=$(nvim --server "$SOCK" --remote-expr 'getcwd()' 2>/dev/null || pwd)
        else
            NVIM_CWD=$(pwd)
        fi
        CWD_KEY=$(echo "$NVIM_CWD" | sed 's|/|_|g; s|^_||')
        NOTES_FILE="/tmp/nvc-notes-${CWD_KEY}.md"
        if [ -f "$NOTES_FILE" ] && [ -s "$NOTES_FILE" ]; then
            cat "$NOTES_FILE"
        else
            echo "No notes found"
        fi
        exit 0
        ;;
    cmd)
        # Send raw keys to nvim
        ensure_nvim_running
        nvim --server "$SOCK" --remote-send "$2"
        exit 0
        ;;
    expr)
        # Evaluate expression
        ensure_nvim_running
        nvim --server "$SOCK" --remote-expr "$2"
        exit 0
        ;;
    messages)
        # Get raw :messages
        ensure_nvim_running
        nvim --server "$SOCK" --remote-expr 'execute("messages")'
        exit 0
        ;;
    errors)
        # Extract errors from noice.nvim notifications
        ensure_nvim_running
        nvim --server "$SOCK" --remote-send ':lua local f=io.open("/tmp/nvim-cmd-errors.txt","w"); local ok,mgr=pcall(require,"noice.message.manager"); if ok then for _,m in ipairs(mgr.get({error=true},{history=true,sort=true})) do f:write(m:content().."\n") end; for _,m in ipairs(mgr.get({warning=true},{history=true,sort=true})) do f:write(m:content().."\n") end end; f:write(vim.fn.execute("messages")); f:write("\nv:errmsg=" .. vim.v.errmsg); f:close()<CR>'
        sleep 0.5
        cat /tmp/nvim-cmd-errors.txt
        exit 0
        ;;
    review)
        # Review a diff, commit, or rev
        # nvc review [--light] [--amend] [--since-publish] [rev]
        #   --light: gutter highlights (signify) instead of full diffview
        #   --amend: show only changes from the last amend (diff current vs predecessor)
        #   --since-publish: show changes since last jf submit (diff current vs published version)
        #   rev: D12345, hash, or . (defaults to . for --light, picker for heavy)
        shift
        LIGHT_MODE=false
        AMEND_MODE=false
        SINCE_PUBLISH=false
        DIFF_ID=""
        for arg in "$@"; do
            case "$arg" in
                --light) LIGHT_MODE=true ;;
                --amend) AMEND_MODE=true ;;
                --since-publish) SINCE_PUBLISH=true ;;
                *) DIFF_ID="$arg" ;;
            esac
        done

        # --since-publish: resolve the last-published commit via jf get
        AMEND_BASE=""
        if [ "$SINCE_PUBLISH" = true ]; then
            PUBLISH_REV="${DIFF_ID:-.}"
            REPO_FOR_PUBLISH=$(sl root 2>/dev/null || pwd)

            # Get the D-number for the target commit
            PHAB_DIFF=$(cd "$REPO_FOR_PUBLISH" && sl log -r "${PUBLISH_REV}" -T '{phabdiff}' 2>/dev/null || true)
            if [ -z "$PHAB_DIFF" ]; then
                echo "Error: no Phabricator diff found for ${PUBLISH_REV}" >&2
                exit 1
            fi

            # Download the published version and extract commit hash
            echo "Fetching published version of ${PHAB_DIFF}..." >&2
            JF_OUTPUT=$(cd "$REPO_FOR_PUBLISH" && jf get "$PHAB_DIFF" --raw 2>&1 || true)
            AMEND_BASE=$(echo "$JF_OUTPUT" | grep "success Requested commit available as" | sed 's/.*available as //' | tr -d '.')
            if [ -z "$AMEND_BASE" ]; then
                echo "Error: could not fetch published version of ${PHAB_DIFF}" >&2
                echo "$JF_OUTPUT" >&2
                exit 1
            fi

            DIFF_ID="$PUBLISH_REV"
            nvc_log "since-publish mode: rev=${PUBLISH_REV} diff=${PHAB_DIFF} published=${AMEND_BASE}"
            echo "Comparing against published ${PHAB_DIFF} (${AMEND_BASE})" >&2

        elif [ "$AMEND_MODE" = true ]; then
            # --amend: resolve predecessor of target commit
            AMEND_REV="${DIFF_ID:-.}"
            AMEND_BASE=$(cd "${REVIEW_REPO:-$(sl root 2>/dev/null || pwd)}" && sl log -r "last(predecessors(${AMEND_REV}) - ${AMEND_REV})" --template '{node|short}' 2>/dev/null || true)
            if [ -z "$AMEND_BASE" ]; then
                echo "Error: no predecessor found for ${AMEND_REV} (commit has not been amended)" >&2
                exit 1
            fi
            DIFF_ID="$AMEND_REV"
            nvc_log "amend mode: rev=${AMEND_REV} predecessor=${AMEND_BASE}"
        fi

        # For non-D arguments, resolve hash + repo in the shell's cwd
        # (nvim may be running in a different repo)
        REVIEW_REPO=""
        if [ -n "$DIFF_ID" ] && [[ ! "$DIFF_ID" =~ ^D ]]; then
            REVIEW_REPO=$(sl root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null || true)
            REVIEW_HASH=$(sl log --rev "${DIFF_ID}" --template '{node|short}' 2>/dev/null || git rev-parse --short "${DIFF_ID}" 2>/dev/null || true)
            if [ -z "$REVIEW_HASH" ] || [ -z "$REVIEW_REPO" ]; then
                echo "Could not resolve '${DIFF_ID}' in $(pwd)" >&2
                exit 1
            fi
            DIFF_ID="$REVIEW_HASH"
        fi

        # For D* diffs, resolve repo root so nvim can cd there
        if [ -n "$DIFF_ID" ] && [[ "$DIFF_ID" =~ ^D ]] && [ -z "$REVIEW_REPO" ]; then
            REVIEW_REPO=$(sl root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null || true)
        fi

        # For D* diffs in light mode, resolve to local hash (signify needs a revspec)
        if [ "$LIGHT_MODE" = true ] && [ -n "$DIFF_ID" ] && [[ "$DIFF_ID" =~ ^D ]]; then
            RESOLVED_HASH=$(sl log -r "phabdiff('${DIFF_ID}')" --template '{node|short}' 2>/dev/null || true)
            [ -n "$RESOLVED_HASH" ] && DIFF_ID="$RESOLVED_HASH"
        fi

        if [ "$LIGHT_MODE" = true ]; then
            # --- Light review: gutter highlights via signify ---
            # No arg = working tree (uncommitted changes), signify normal mode
            # With rev = commit review, signify review mode (diff against rev^)
            if [ -n "$REVIEW_REPO" ]; then
                REPO_ROOT="$REVIEW_REPO"
            else
                REPO_ROOT=$(sl root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null || echo "$HOME")
            fi

            # Collect changed files
            CHANGED_FILES=()
            if [ -n "$AMEND_BASE" ]; then
                # Amend/since-publish: files changed between base and current
                while IFS= read -r f; do
                    [ -n "$f" ] && CHANGED_FILES+=("${REPO_ROOT}/${f}")
                done < <(cd "$REPO_ROOT" && sl diff -r "${AMEND_BASE}" -r "${DIFF_ID}" 2>/dev/null | grep "^diff " | sed 's|.* b/||')
                REVIEW_LABEL="changes vs ${AMEND_BASE}"
            elif [ -z "$DIFF_ID" ]; then
                # Working tree — uncommitted changes
                while IFS= read -r f; do
                    [ -n "$f" ] && CHANGED_FILES+=("${REPO_ROOT}/${f}")
                done < <(cd "$REPO_ROOT" && sl status --no-status 2>/dev/null)
                REVIEW_LABEL="working tree"
            else
                # Specific commit
                while IFS= read -r f; do
                    [ -n "$f" ] && CHANGED_FILES+=("${REPO_ROOT}/${f}")
                done < <(cd "$REPO_ROOT" && sl status --change "${DIFF_ID}" --no-status 2>/dev/null)
                REVIEW_LABEL="rev ${DIFF_ID}"
            fi

            # Ensure nvim is running (spawns if needed, handles session)
            ensure_nvim_running

            # cd nvim to repo root and open all changed files in one command
            EDIT_CMDS="cd ${REPO_ROOT}"
            for f in "${CHANGED_FILES[@]}"; do
                EDIT_CMDS="${EDIT_CMDS} | badd ${f}"
            done
            # Open the last file as the active buffer
            if [ ${#CHANGED_FILES[@]} -gt 0 ]; then
                EDIT_CMDS="${EDIT_CMDS} | edit ${CHANGED_FILES[-1]}"
            fi
            nvim --server "$SOCK" --remote-send "<Esc>:${EDIT_CMDS}<CR>"

            # Set signify mode via RPC
            if [ -n "$AMEND_BASE" ]; then
                nvim --server "$SOCK" --remote-send "<Esc>:lua _G.signify_review.light_review('amend', '${DIFF_ID}', '${AMEND_BASE}')<CR>"
            elif [ -z "$DIFF_ID" ]; then
                nvim --server "$SOCK" --remote-send "<Esc>:lua _G.signify_review.light_review('working_tree')<CR>"
            else
                nvim --server "$SOCK" --remote-send "<Esc>:lua _G.signify_review.light_review('toggle', '${DIFF_ID}')<CR>"
            fi
            echo "Light review (${REVIEW_LABEL}), ${#CHANGED_FILES[@]} file(s)" >&2
        else
            # --- Heavy review: full diffview ---
            if [ -n "$AMEND_BASE" ]; then
                # Amend/since-publish review via diffview
                ensure_nvim_running
                nvim --server "$SOCK" --remote-send "<Esc>:DiffviewOpen ${AMEND_BASE}...${DIFF_ID}<CR>"
                echo "Reviewing changes (${AMEND_BASE} → ${DIFF_ID})" >&2
            elif socket_alive; then
                if [ -n "$DIFF_ID" ]; then
                    if [ -n "$REVIEW_REPO" ]; then
                        nvim --server "$SOCK" --remote-send "<Esc>:ReviewDiff ${DIFF_ID} ${REVIEW_REPO}<CR>"
                    else
                        nvim --server "$SOCK" --remote-send "<Esc>:ReviewDiff ${DIFF_ID}<CR>"
                    fi
                    echo "Reviewing ${DIFF_ID}" >&2
                else
                    nvim --server "$SOCK" --remote-send '<Esc>:ReviewDiff<CR>'
                    echo "Opening review picker" >&2
                fi
            else
                if [ -n "$REVIEW_REPO" ]; then
                    REPO_ROOT="$REVIEW_REPO"
                else
                    REPO_ROOT=$(sl root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null || echo "$HOME")
                fi
                ensure_nvim_running
                nvim --server "$SOCK" --remote-send "<Esc>:cd ${REPO_ROOT}<CR>"
                if [ -n "$DIFF_ID" ]; then
                    if [ -n "$REVIEW_REPO" ]; then
                        nvim --server "$SOCK" --remote-send "<Esc>:ReviewDiff ${DIFF_ID} ${REVIEW_REPO}<CR>"
                    else
                        nvim --server "$SOCK" --remote-send "<Esc>:ReviewDiff ${DIFF_ID}<CR>"
                    fi
                    echo "Reviewing ${DIFF_ID}" >&2
                else
                    nvim --server "$SOCK" --remote-send '<Esc>:ReviewDiff<CR>'
                    echo "Opening review picker" >&2
                fi
            fi
        fi
        exit 0
        ;;
    send)
        # Send prompt text to the Claude Code pane
        # Usage: nvc send [--no-submit] [--pane <id>] [--file <path>] [< stdin]
        shift
        NO_SUBMIT=false
        INPUT_FILE=""
        TARGET_PANE=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --no-submit) NO_SUBMIT=true; shift ;;
                --file) INPUT_FILE="$2"; shift 2 ;;
                --pane) TARGET_PANE="$2"; shift 2 ;;
                *) echo "Usage: nvc send [--no-submit] [--pane <id>] [--file <path>]" >&2; exit 1 ;;
            esac
        done

        # Resolve Claude pane: explicit > UUID session > bootstrap
        if [ -z "$TARGET_PANE" ]; then
            TARGET_PANE=$(resolve_claude_pane || true)
            nvc_log "send: resolved target=${TARGET_PANE:-empty}"
        fi
        if [ -z "$TARGET_PANE" ]; then
            nvc_log "send: no Claude found — bootstrapping"
            TARGET_PANE=$(bootstrap_claude)
            nvc_log "send: bootstrapped target=${TARGET_PANE}"
        fi

        # Read input from file or stdin
        if [ -n "$INPUT_FILE" ]; then
            if [ ! -f "$INPUT_FILE" ]; then
                echo "Error: file not found: $INPUT_FILE" >&2
                exit 1
            fi
        else
            INPUT_FILE="/tmp/nvc-send-$$.txt"
            cat > "$INPUT_FILE"
            trap 'rm -f "$INPUT_FILE"' EXIT
        fi

        # Inject via tmux paste-buffer (safe for any content including code)
        tmux load-buffer -b nvc_send "$INPUT_FILE"
        tmux paste-buffer -b nvc_send -t "$TARGET_PANE" -p
        tmux delete-buffer -b nvc_send 2>/dev/null || true

        if [ "$NO_SUBMIT" = false ]; then
            tmux send-keys -t "$TARGET_PANE" Enter
        fi

        echo "Sent to Claude (pane $TARGET_PANE)" >&2
        exit 0
        ;;
    diff-review)
        # Interactive diff review: show proposed changes, let user cherry-pick
        # Usage: echo "proposed content" | nvc diff-review <file>
        # User accepts (<leader>aa / :w) or rejects (<leader>ad / :q)
        # Result is sent back to Claude via nvc send
        shift
        FILE="${1:-}"
        if [ -z "$FILE" ]; then
            echo "Usage: echo 'proposed' | nvc diff-review <file>" >&2
            exit 1
        fi
        [[ "$FILE" != /* ]] && FILE="$(pwd)/$FILE"
        if [ ! -f "$FILE" ]; then
            echo "Error: file not found: $FILE" >&2
            exit 1
        fi

        # Save proposed content to temp file
        REVIEW_ID="$$-$(date +%s)"
        PROPOSED="/tmp/nvc-diff-review-${REVIEW_ID}-proposed"
        cat > "$PROPOSED"

        ensure_nvim_running

        # Generate Lua to open interactive diff review
        cat > /tmp/nvc-diff-review-${REVIEW_ID}.lua << LUAEOF
require("claude.diff_review").open("${FILE}", "${PROPOSED}", "${REVIEW_ID}")
LUAEOF

        nvim --server "$SOCK" --remote-send "<Esc>:luafile /tmp/nvc-diff-review-${REVIEW_ID}.lua<CR>"
        echo "Opened diff review for ${FILE##*/}" >&2
        exit 0
        ;;
    diagnostics)
        # Get LSP diagnostics from nvim
        # Usage: nvc diagnostics          — all diagnostics
        #        nvc diagnostics <file>   — diagnostics for a specific file
        shift
        FILE="${1:-}"
        [[ -n "$FILE" && "$FILE" != /* ]] && FILE="$(pwd)/$FILE"

        if ! socket_alive; then
            echo "No nvim instance running" >&2
            exit 1
        fi

        local_out="/tmp/nvc-diagnostics-$$.txt"
        if [ -n "$FILE" ]; then
            FILTER="local bufnr = vim.fn.bufnr('${FILE}'); if bufnr == -1 then diags = {} else diags = vim.diagnostic.get(bufnr) end"
        else
            FILTER="diags = vim.diagnostic.get()"
        fi

        cat > /tmp/nvc-diagnostics-$$.lua << LUAEOF
local diags
${FILTER}
local sev_map = { [1]="ERROR", [2]="WARN", [3]="INFO", [4]="HINT" }
local lines = {}
for _, d in ipairs(diags) do
  local fname = vim.api.nvim_buf_get_name(d.bufnr)
  local root = vim.fs.root(fname, ".hg") or vim.fs.root(fname, ".git") or ""
  if root ~= "" then fname = fname:sub(#root + 2) end
  local sev = sev_map[d.severity] or "?"
  local src = d.source and (" [" .. d.source .. "]") or ""
  table.insert(lines, string.format("%s:%d: %s: %s%s", fname, d.lnum + 1, sev, d.message, src))
end
local f = io.open("${local_out}", "w")
if #lines == 0 then
  f:write("No diagnostics\n")
else
  f:write(table.concat(lines, "\n") .. "\n")
end
f:close()
LUAEOF

        nvim --server "$SOCK" --remote-send "<Esc>:luafile /tmp/nvc-diagnostics-$$.lua<CR>"
        sleep 0.5
        cat "$local_out"
        rm -f "$local_out" "/tmp/nvc-diagnostics-$$.lua"
        exit 0
        ;;
    buffers)
        # List open buffers with metadata
        if ! socket_alive; then
            echo "No nvim instance running" >&2
            exit 1
        fi

        local_out="/tmp/nvc-buffers-$$.txt"
        cat > /tmp/nvc-buffers-$$.lua << LUAEOF
local lines = {}
for _, bufnr in ipairs(vim.api.nvim_list_bufs()) do
  if vim.api.nvim_buf_is_loaded(bufnr) and vim.bo[bufnr].buflisted then
    local name = vim.api.nvim_buf_get_name(bufnr)
    if name ~= "" then
      local root = vim.fs.root(name, ".hg") or vim.fs.root(name, ".git") or ""
      if root ~= "" then name = name:sub(#root + 2) end
      local ft = vim.bo[bufnr].filetype or ""
      local modified = vim.bo[bufnr].modified
      local flags = {}
      if modified then table.insert(flags, "modified") end
      if bufnr == vim.fn.bufnr() then table.insert(flags, "active") end
      local meta = ""
      if #flags > 0 then meta = " [" .. table.concat(flags, ", ") .. "]" end
      if ft ~= "" then
        table.insert(lines, string.format("%s (%s)%s", name, ft, meta))
      else
        table.insert(lines, string.format("%s%s", name, meta))
      end
    end
  end
end
local f = io.open("${local_out}", "w")
if #lines == 0 then
  f:write("No open buffers\n")
else
  f:write(table.concat(lines, "\n") .. "\n")
end
f:close()
LUAEOF

        nvim --server "$SOCK" --remote-send "<Esc>:luafile /tmp/nvc-buffers-$$.lua<CR>"
        sleep 0.5
        cat "$local_out"
        rm -f "$local_out" "/tmp/nvc-buffers-$$.lua"
        exit 0
        ;;
    test)
        # Integration tests — delegates to nvc-test
        shift
        exec nvc-test "$@"
        ;;
esac

# ============================================================================
# File/highlight/diff modes (original nvim-show logic)
# ============================================================================

CLEAR_HIGHLIGHTS=false
CLOSE_DIFF=false
DIFF_MODE=false
QUERIES=()

if [ $# -lt 1 ]; then
    echo "Usage: nvc <file>:<line>                         Open file" >&2
    echo "       nvc --highlight-function <file>:<line>    Highlight function" >&2
    echo "       nvc --highlight <file>:<line>             Highlight block" >&2
    echo "       nvc --highlight-lines <file>:<s>-<e>      Highlight lines" >&2
    echo "       nvc --diff <file>                         Show diff (stdin)" >&2
    echo "       nvc --clear                               Clear highlights" >&2
    echo "       nvc review [--light] [D12345|hash|.]       Review diff/commit/rev" >&2
    echo "       nvc debug set-breakpoints <file:line> ...  Set breakpoints" >&2
    echo "       nvc debug attach                          Start DAP session" >&2
    echo "       nvc debug clear-breakpoints               Clear breakpoints" >&2
    echo "       nvc send [--no-submit] [--file <path>]     Send prompt to Claude" >&2
    echo "       nvc diff-review <file>                    Interactive diff review" >&2
    echo "       nvc diagnostics [file]                    Get LSP diagnostics" >&2
    echo "       nvc buffers                               List open buffers" >&2
    echo "       nvc cmd '<keys>'                          Send raw keys" >&2
    echo "       nvc expr '<expr>'                         Eval expression" >&2
    echo "       nvc errors                                Get errors" >&2
    exit 1
fi

# Check for simple flags
for arg in "$@"; do
    if [[ "$arg" == "--clear" ]]; then CLEAR_HIGHLIGHTS=true; fi
    if [[ "$arg" == "--close-diff" ]]; then CLOSE_DIFF=true; fi
done

if [ "$CLEAR_HIGHLIGHTS" = true ] || [ "$CLOSE_DIFF" = true ]; then
    :
else
    CURRENT_MODE=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --highlight-function) CURRENT_MODE="function"; shift ;;
            --highlight) CURRENT_MODE="block"; shift ;;
            --highlight-lines) CURRENT_MODE="lines"; shift ;;
            --diff) DIFF_MODE=true; shift ;;
            *)
                ARG="$1"; shift

                if [[ "$ARG" == +* ]]; then
                    if [ ${#QUERIES[@]} -gt 0 ]; then
                        LAST="${QUERIES[-1]}"
                        IFS='|' read -r qm qf _ qe <<< "$LAST"
                        QUERIES[-1]="${qm}|${qf}|${ARG#+}|${qe}"
                    fi
                    continue
                fi

                if [ "$DIFF_MODE" = true ]; then
                    FILE="$ARG"
                    [[ "$FILE" == *:* ]] && FILE="${ARG%:*}"
                    [[ "$FILE" != /* ]] && FILE="$(pwd)/$FILE"
                    QUERIES+=("diff|${FILE}||")
                    continue
                fi

                if [ "$CURRENT_MODE" = "lines" ]; then
                    if [[ "$ARG" =~ ^(.+):([0-9].*) ]]; then
                        FILE="${BASH_REMATCH[1]}"
                        RANGES="${BASH_REMATCH[2]}"
                        [[ "$FILE" != /* ]] && FILE="$(pwd)/$FILE"
                        IFS=',' read -ra RANGE_PARTS <<< "$RANGES"
                        for rng in "${RANGE_PARTS[@]}"; do
                            if [[ "$rng" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                                QUERIES+=("lines|${FILE}|${BASH_REMATCH[1]}|${BASH_REMATCH[2]}")
                            elif [[ "$rng" =~ ^([0-9]+):([0-9]+)$ ]]; then
                                QUERIES+=("lines|${FILE}|${BASH_REMATCH[1]}|${BASH_REMATCH[2]}")
                            elif [[ "$rng" =~ ^([0-9]+)$ ]]; then
                                QUERIES+=("lines|${FILE}|${BASH_REMATCH[1]}|${BASH_REMATCH[1]}")
                            fi
                        done
                    fi
                elif [ -n "$CURRENT_MODE" ]; then
                    if [[ "$ARG" == *:* ]]; then
                        FILE="${ARG%:*}"; LINE="${ARG##*:}"
                    else
                        FILE="$ARG"; LINE=""
                    fi
                    [[ "$FILE" != /* ]] && FILE="$(pwd)/$FILE"
                    QUERIES+=("${CURRENT_MODE}|${FILE}|${LINE}|")
                else
                    if [[ "$ARG" == *:* ]]; then
                        FILE="${ARG%:*}"; LINE="${ARG##*:}"
                    else
                        FILE="$ARG"; LINE=""
                    fi
                    [[ "$FILE" != /* ]] && FILE="$(pwd)/$FILE"
                    QUERIES+=("open|${FILE}|${LINE}|")
                fi

                CURRENT_MODE=""
                ;;
        esac
    done
fi

# ============================================================================
# Lua generators
# ============================================================================

write_highlight_lua() {
    local lua_queries=""
    local idx=0
    while [ $# -gt 0 ]; do
        local mode="$1" file="$2" line="$3" line_end="$4"
        shift 4
        [ $idx -gt 0 ] && lua_queries="${lua_queries},"$'\n'
        lua_queries="${lua_queries}  { mode = '${mode}', file = '${file}', line = ${line:-0}, line_end = ${line_end:-0} }"
        idx=$((idx + 1))
    done

    cat > /tmp/nvim-claude-highlight.lua << LUAEOF
require("claude.highlight").highlight({
${lua_queries}
})
LUAEOF
}

# ============================================================================
# Open file in nvim
# ============================================================================

open_in_nvim() {
    local file="$1" line="$2"
    if $FULL_SCREEN && ! socket_alive; then
        local nvim_args="--listen $SOCK"
        [ -n "$line" ] && nvim_args="$nvim_args +${line}"
        spawn_nvim "nvim $nvim_args ${file}"
    else
        ensure_nvim_running
        local nvim_cmd
        [ -n "$line" ] && nvim_cmd=":e +${line} ${file}" || nvim_cmd=":e ${file}"
        nvim --server "$SOCK" --remote-send "<Esc>${nvim_cmd}<CR>"
    fi
    echo "Opened ${file}${line:+:$line}" >&2
}

# ============================================================================
# Main dispatch
# ============================================================================

if [ "$CLEAR_HIGHLIGHTS" = true ]; then
    if socket_alive; then
        nvim --server "$SOCK" --remote-send '<Esc>:lua require("claude.highlight").clear()<CR>'
        echo "Cleared all Claude highlights" >&2
    else
        echo "Nothing to clear (no nvim running)" >&2
    fi
    exit 0
fi

if [ "$CLOSE_DIFF" = true ]; then
    if socket_alive; then
        nvim --server "$SOCK" --remote-send '<Esc>:windo diffoff<CR>:only<CR>'
        echo "Closed diff view" >&2
    else
        echo "Nothing to close (no nvim running)" >&2
    fi
    exit 0
fi

if [ ${#QUERIES[@]} -eq 0 ]; then
    echo "Error: no file or query specified" >&2
    exit 1
fi

HAS_HIGHLIGHT=false
HAS_DIFF=false
for q in "${QUERIES[@]}"; do
    IFS='|' read -r mode _ _ _ <<< "$q"
    case "$mode" in
        function|block|lines) HAS_HIGHLIGHT=true ;;
        diff) HAS_DIFF=true ;;
    esac
done

if [ "$HAS_DIFF" = true ]; then
    IFS='|' read -r _ FILE _ _ <<< "${QUERIES[0]}"
    PROPOSED="/tmp/nvim-claude-proposed${FILE##*/}"
    cat > "$PROPOSED"
    if socket_alive; then
        nvim --server "$SOCK" --remote-send '<C-\><C-n>:lua pcall(function() require("dap").terminate() end); vim.cmd("qa!")<CR>' 2>/dev/null
        sleep 0.5
    fi
    [ -e "$SOCK" ] && rm -f "$SOCK"
    tmux split-window -t "${TMUX_PANE}" -h -l 50% "nvim --listen $SOCK -d $FILE $PROPOSED"
    echo "Showing diff for ${FILE}" >&2

elif [ "$HAS_HIGHLIGHT" = true ]; then
    ensure_nvim_running
    for q in "${QUERIES[@]}"; do
        IFS='|' read -r _ qfile _ _ <<< "$q"
        if [ ! -f "$qfile" ]; then echo "Error: file not found: $qfile" >&2; exit 1; fi
    done
    LUA_ARGS=()
    DISPLAY_PARTS=()
    for q in "${QUERIES[@]}"; do
        IFS='|' read -r mode file line line_end <<< "$q"
        LUA_ARGS+=("$mode" "$file" "$line" "$line_end")
        local_display="${file##*/}:${line}"
        [ -n "$line_end" ] && [ "$line_end" != "0" ] && local_display="${local_display}-${line_end}"
        [ "$mode" = "function" ] && local_display="${local_display}(fn)"
        [ "$mode" = "block" ] && local_display="${local_display}(block)"
        DISPLAY_PARTS+=("$local_display")
    done
    write_highlight_lua "${LUA_ARGS[@]}"
    nvim --server "$SOCK" --remote-send '<Esc>:luafile /tmp/nvim-claude-highlight.lua<CR>'
    DISPLAY=$(IFS=', '; echo "${DISPLAY_PARTS[*]}")
    echo "Highlighted: ${DISPLAY}" >&2

else
    if [ ${#QUERIES[@]} -eq 1 ]; then
        IFS='|' read -r _ file line _ <<< "${QUERIES[0]}"
        [ ! -e "$file" ] && echo "Error: path not found: $file" >&2 && exit 1
        open_in_nvim "$file" "$line"
    else
        ensure_nvim_running
        for q in "${QUERIES[@]}"; do
            IFS='|' read -r _ file line _ <<< "$q"
            [ ! -e "$file" ] && echo "Warning: path not found: $file" >&2 && continue
            nvim --server "$SOCK" --remote-send "<Esc>:e ${file}<CR>"
        done
        IFS='|' read -r _ file line _ <<< "${QUERIES[-1]}"
        [ -n "$line" ] && nvim --server "$SOCK" --remote-send "<Esc>:${line}<CR>"
        echo "Opened ${#QUERIES[@]} files in nvim" >&2
    fi
fi
