#!/usr/bin/env python3
"""ascii-art-fix v2.0.0 — Display-width-aware ASCII art verifier and fixer.

Checks and fixes Unicode box-drawing alignment in markdown code blocks,
handling wide characters (emojis) correctly.

Features:
  - Outer box border alignment (┌┐└┘│├┤)
  - Inner/nested box border alignment
  - Side-by-side boxes (KPI cards) handled without false positives
  - Sequence diagram pipe alignment (auto-detected column grid)
  - Emoji/CJK display width awareness (2-column chars)
  - Stray ASCII detection (+, -->, mixed ─/-)
  - Iterative convergence for cascading inner→outer fixes

Usage:
  ascii-art-fix verify <file>   # check only, exit 1 on errors
  ascii-art-fix fix <file>      # fix and re-verify
  ascii-art-fix --version
"""
__version__ = "2.0.0"

import re
import sys
import unicodedata


def char_width(c):
    eaw = unicodedata.east_asian_width(c)
    return 2 if eaw in ('W', 'F') else 1


def display_width(s):
    return sum(char_width(c) for c in s)


def display_col_of_char(s, char_idx):
    col = 0
    for i in range(char_idx):
        col += char_width(s[i])
    return col


def find_all_display(s, ch):
    """Return list of (char_index, display_column) for all occurrences of ch."""
    results = []
    col = 0
    for i, c in enumerate(s):
        if c == ch:
            results.append((i, col))
        col += char_width(c)
    return results


ARROW_CHARS = set('─><')
BOX_CROSS_CHARS = set('┴┬┼├┤┌┐└┘')
PIPE_LIKE = set('│┴┬┼├┤')


def detect_seq_columns(line):
    """If line looks like a sequence diagram pipe line (≥3 pipes separated by
    spaces), return the list of display columns. Otherwise return None."""
    pipes = find_all_display(line, '│')
    if len(pipes) < 3:
        return None
    for ci, dc in pipes:
        if ci > 0 and line[ci - 1] not in (' ', '\t'):
            return None
        if ci < len(line) - 1 and line[ci + 1] not in (' ', '\t', '\n'):
            return None
    return [dc for _, dc in pipes]


def reflow_seq_line(line, ref_cols, fix=False):
    """Check/fix a sequence diagram line so that pipe-like characters land at
    the reference display columns.

    Returns (fixed_line, errors_list). Errors are strings like 'pipe at dcol X, expected Y'.

    Strategy: walk through reference columns left-to-right. For each one,
    find the nearest pipe-like or arrow/box-cross character within a tolerance
    window. If it's a pipe that's offset, adjust whitespace before it.
    If the column is occupied by arrow/box chars, skip it (intentional crossing).
    """
    errors = []
    if not line.strip():
        return line, errors

    # Skip lines with box border corners — their │ are box walls.
    if '┌' in line or '└' in line or '┐' in line or '┘' in line:
        return line, errors

    # Skip box content lines: if fewer than half of the pipe positions match
    # a reference column (within ±1), this line is likely inside a nested box
    # rather than a normal sequence diagram line.
    pipe_dcols = set()
    dcol_tmp = 0
    for c in line:
        if c == '│':
            pipe_dcols.add(dcol_tmp)
        dcol_tmp += char_width(c)
    if pipe_dcols:
        exact_matches = sum(1 for p in pipe_dcols if any(abs(p - r) <= 1 for r in ref_cols))
        if len(pipe_dcols) >= 3 and exact_matches < len(pipe_dcols) // 2:
            return line, errors

    chars = list(line.rstrip('\n'))
    result_chars = []
    current_dcol = 0
    char_idx = 0

    ref_set = set(ref_cols)
    ref_sorted = sorted(ref_cols)

    col_char_map = {}
    dcol = 0
    for ci, c in enumerate(chars):
        col_char_map[dcol] = (ci, c)
        dcol += char_width(c)
    total_dcol = dcol

    for ref_dc in ref_sorted:
        ci_at_ref, ch_at_ref = None, None
        if ref_dc in col_char_map:
            ci_at_ref, ch_at_ref = col_char_map[ref_dc]

        if ch_at_ref == '│':
            continue

        if ch_at_ref in BOX_CROSS_CHARS:
            continue

        nearby = None
        for offset in (1, -1, 2, -2, 3, -3, 4, -4):
            dc = ref_dc + offset
            if dc in col_char_map:
                ci, ch = col_char_map[dc]
                if ch == '│':
                    nearby = (dc, ci, ch, offset)
                    break

        if nearby:
            actual_dc, ci, ch, offset = nearby
            errors.append(f'pipe at dcol {actual_dc}, expected {ref_dc}')

    if not fix or not errors:
        return line, errors

    fixed = _reflow_seq_line_fix(chars, ref_sorted, col_char_map, total_dcol)
    return fixed, errors


def _reflow_seq_line_fix(chars, ref_sorted, col_char_map, total_dcol):
    """Rebuild line by adjusting whitespace/fill around each reference column.

    Arrow-aware: when a pipe is preceded by '>' (arrow head), extends or
    shrinks the '─' run inside the arrow instead of inserting spaces.
    """
    line = ''.join(chars)

    pipe_positions = []
    dcol = 0
    for ci, c in enumerate(line):
        if c == '│':
            pipe_positions.append((ci, dcol))
        dcol += char_width(c)

    if not pipe_positions:
        return line

    if len(pipe_positions) != len(ref_sorted):
        actual_dcs = [dc for _, dc in pipe_positions]
        raw_matched = _match_pipes_to_refs(actual_dcs, ref_sorted)
        matched = []
        dc_to_ci = {dc: ci for ci, dc in pipe_positions}
        for actual_dc, target_dc in raw_matched:
            matched.append((dc_to_ci[actual_dc], actual_dc, target_dc))
    else:
        matched = [(ci, dc, ref) for (ci, dc), ref in zip(pipe_positions, ref_sorted)]

    if not matched:
        return line

    new_chars = list(line)
    for ci, actual_dc, target_dc in sorted(matched, key=lambda x: -x[0]):
        shift = target_dc - actual_dc
        if shift == 0:
            continue

        # Determine what's before this pipe to choose fill character
        prev_char = new_chars[ci - 1] if ci > 0 else ' '
        is_arrow = prev_char in ('>', '─')

        if shift > 0:
            if is_arrow:
                fill_pos = ci
                while fill_pos > 0 and new_chars[fill_pos - 1] in ('─', '>'):
                    fill_pos -= 1
                new_chars[fill_pos:fill_pos] = ['─'] * shift
            else:
                new_chars[ci:ci] = [' '] * shift
        else:
            remove_count = -shift
            # Remove fill chars immediately before the pipe: spaces and ─.
            # Never remove arrow heads (> <). Stop at any other character.
            pos = ci - 1
            removed = 0
            while removed < remove_count and pos >= 0:
                ch = new_chars[pos]
                if ch in (' ', '─'):
                    new_chars.pop(pos)
                    removed += 1
                    pos -= 1
                elif ch == '>':
                    # Skip arrow head — remove ─ behind it instead
                    pos -= 1
                else:
                    break

    return ''.join(new_chars)


def _match_pipes_to_refs(actual_dcols, ref_cols):
    """Match actual pipe display columns to reference columns by proximity."""
    matched = []
    used_refs = set()
    for actual_dc in actual_dcols:
        best_ref = None
        best_dist = 999
        for ref_dc in ref_cols:
            if ref_dc in used_refs:
                continue
            dist = abs(actual_dc - ref_dc)
            if dist < best_dist:
                best_dist = dist
                best_ref = ref_dc
        if best_ref is not None and best_dist <= 6:
            matched.append((actual_dc, best_ref))
            used_refs.add(best_ref)
    return matched


def fix_border_at_dcol(s, border_char, current_cidx, target_dcol):
    """Move a border character from current_cidx to target_dcol by
    adjusting whitespace/fill before it."""
    fill = '─' if border_char in ('┤', '┘') else ' '

    before = s[:current_cidx]
    after = s[current_cidx + 1:]

    before_stripped = before.rstrip(fill).rstrip(' ')
    before_dw = display_width(before_stripped)
    needed = target_dcol - before_dw

    if needed <= 0:
        return s

    return before_stripped + fill * needed + border_char + after


def verify(filepath, fix=False):
    lines = open(filepath).readlines()

    in_code = False
    is_wireframe = False
    result = []
    errors = 0
    fixes = 0

    box_stack = []  # [(left_cidx, right_dcol, start_line), ...]
    outer_dcol = None
    seq_columns = None  # sequence diagram column grid (list of display cols)

    for i, raw in enumerate(lines):
        s = raw.rstrip('\n')
        stripped = s.strip()

        if stripped.startswith('```'):
            if not in_code:
                in_code = True
                is_wireframe = (stripped == '```')
                outer_dcol = None
                box_stack = []
                seq_columns = None
            else:
                in_code = False
                is_wireframe = False
                seq_columns = None
            result.append(raw)
            continue

        if not in_code or not is_wireframe:
            result.append(raw)
            continue

        # --- Sequence diagram detection ---
        if seq_columns is None:
            detected = detect_seq_columns(s)
            if detected:
                seq_columns = detected

        # --- Sequence diagram pipe alignment ---
        # Skip reflow when inside a nested box (box_stack has an entry
        # whose left_cidx > 0, meaning it's not the outer border).
        in_nested_box = any(left > 0 for left, _, _ in box_stack)
        if seq_columns is not None and not in_nested_box:
            fixed_line, seq_errors = reflow_seq_line(s, seq_columns, fix=fix)
            if seq_errors:
                for err in seq_errors:
                    if fix:
                        fixes += 1
                    else:
                        print(f'L{i+1}: {err}')
                        errors += 1
            if fix and seq_errors:
                s = fixed_line

        # --- Static checks ---
        if re.search(r'\+[-─]{2,}', s) or re.search(r'[-─]{2,}\+', s):
            print(f'L{i+1}: stray + among box chars'); errors += 1
        if re.search(r'-{3,}>', s):
            print(f'L{i+1}: ASCII arrow --->'); errors += 1
        if re.search(r'┌[─]*[v▼][─]*┐', s):
            print(f'L{i+1}: arrow inside border'); errors += 1

        # --- Detect box openings (┌...┐) ---
        col = 0
        for j, c in enumerate(s):
            if c == '┌':
                right_idx = s.find('┐', j + 1)
                if right_idx > 0:
                    right_dcol = display_col_of_char(s, right_idx)
                    if j == 0:
                        outer_dcol = right_dcol
                    box_stack.append((j, right_dcol, i))
            col += char_width(c)

        # --- Detect box closings (└...┘) and pop from stack ---
        for j, c in enumerate(s):
            if c == '└':
                box_stack = [(l, r, sl) for l, r, sl in box_stack if l != j]

        # --- Fix/verify border alignment for all active boxes ---
        # Inner boxes first (higher left_cidx), then outer (0).
        for left_cidx, expected_dcol, _ in sorted(box_stack, key=lambda x: -x[0]):
            if s[0] != '│' if left_cidx == 0 else (len(s) <= left_cidx or s[left_cidx] not in ('│', '├')):
                continue

            if left_cidx == 0:
                border_chars = (
                    find_all_display(s, '│') +
                    find_all_display(s, '┤') +
                    find_all_display(s, '┘')
                )
                if not border_chars:
                    continue
                border_chars.sort(key=lambda x: x[1])
                last_cidx, last_dcol = border_chars[-1]

                if last_dcol != expected_dcol:
                    if fix:
                        ch = s[last_cidx]
                        s = fix_border_at_dcol(s, ch, last_cidx, expected_dcol)
                        fixes += 1
                    else:
                        print(f'L{i+1}: outer border at dcol {last_dcol}, expected {expected_dcol}')
                        errors += 1
            else:
                # Inner box: nearest to expected_dcol, within ±10.
                # Avoids false matches on side-by-side boxes (KPI cards).
                all_borders = (
                    find_all_display(s, '│') +
                    find_all_display(s, '┤')
                )
                candidates = [
                    (ci, dc) for ci, dc in all_borders
                    if ci > left_cidx and abs(dc - expected_dcol) <= 10
                ]

                if not candidates:
                    continue

                candidates.sort(key=lambda x: abs(x[1] - expected_dcol))
                best_cidx, best_dcol = candidates[0]

                if best_dcol != expected_dcol:
                    if fix:
                        ch = s[best_cidx]
                        s = fix_border_at_dcol(s, ch, best_cidx, expected_dcol)
                        fixes += 1
                    else:
                        print(f'L{i+1}: inner border at dcol {best_dcol}, expected {expected_dcol}')
                        errors += 1

        result.append(s + '\n')

    if fix:
        with open(filepath, 'w') as f:
            f.writelines(result)
        print(f'Applied {fixes} fixes')
    else:
        print(f'\n{"All checks passed" if errors == 0 else f"{errors} errors found"}')

    return errors


if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] in ('--version', '-V'):
        print(f'ascii-art-fix {__version__}')
        sys.exit(0)

    if len(sys.argv) < 2 or sys.argv[1] in ('--help', '-h'):
        print(__doc__)
        sys.exit(0)

    mode = sys.argv[1]
    filepath = sys.argv[2] if len(sys.argv) > 2 else None

    if mode not in ('verify', 'fix'):
        print(f"Unknown mode: {mode}")
        print("Usage: ascii-art-fix [verify|fix] <file>")
        sys.exit(1)

    if not filepath:
        print("Missing file argument.")
        print("Usage: ascii-art-fix [verify|fix] <file>")
        sys.exit(1)

    if mode == 'fix':
        for attempt in range(5):
            verify(filepath, fix=True)
            remaining = verify(filepath, fix=False)
            if remaining == 0:
                break
            print(f"\n--- Pass {attempt + 2} ---")
        if remaining > 0:
            print(f"\nWARNING: {remaining} errors remain after 5 passes")
            sys.exit(1)
    else:
        errors = verify(filepath, fix=False)
        sys.exit(1 if errors > 0 else 0)
