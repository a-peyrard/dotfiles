#compdef dotfiles-bundle

# Bundle names, resolved from the repo the dotfiles-bundle symlink points into,
# so this works on any machine without a hardcoded path.
_dotfiles_bundle_names() {
    local repo bundle_toml
    local -a names

    repo="${${:-$(command -v dotfiles-bundle)}:A:h:h:h}"
    for bundle_toml in "$repo"/bundles/*/bundle.toml(N); do
        names+=("${${bundle_toml:h}:t}")
    done

    _describe 'bundle' names
}

_dotfiles-bundle() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            local -a commands
            commands=(
                'list:List available bundles and destinations'
                'status:Show how long ago each bundle was synced'
                'show:Show bundle contents'
                'build:Build bundle tarball'
                'sync:Bidirectional sync (pull + deploy)'
            )
            _describe -t commands 'dotfiles-bundle command' commands
            ;;
        args)
            case $line[1] in
                status)
                    _arguments \
                        '--stale-after[Days before a bundle is flagged stale]:days:'
                    ;;
                show)
                    _arguments \
                        '(-v --verbose)'{-v,--verbose}'[Show all files, not just first 15]' \
                        '1:bundle:_dotfiles_bundle_names'
                    ;;
                build)
                    _arguments \
                        '(-o --output)'{-o,--output}'[Output path]:output:_files' \
                        '1:bundle:_dotfiles_bundle_names'
                    ;;
                sync)
                    _arguments \
                        '(-v --verbose)'{-v,--verbose}'[Show diffs for changed files]' \
                        '--apply[Execute sync (default: preview only)]' \
                        '(-y --yes)'{-y,--yes}'[Sync without confirmation (implies --apply)]' \
                        '*--only[Restrict to paths matching PATTERN]:pattern:' \
                        '(--push-only --push-force)--pull-only[Only write remote changes back locally]' \
                        '(--pull-only)--push-only[Only push local changes]' \
                        '(--pull-only)--push-force[Push even remote-changed files, overwriting them]' \
                        '1:bundle:_dotfiles_bundle_names'
                    ;;
            esac
            ;;
    esac
}

_dotfiles-bundle "$@"
